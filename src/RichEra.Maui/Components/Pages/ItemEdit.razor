@page "/library/new"
@page "/library/item/{Id:guid}/edit"
@using RichEra.Application.Abstractions
@using RichEra.Application.Dtos
@using RichEra.Domain.Entities
@inject IItemService ItemSvc
@inject IAccountService AccountSvc
@inject ICategoryService CategorySvc
@inject NavigationManager Nav

<PageTitle>@(Id is null ? "New item" : "Edit item")</PageTitle>

@* The "Edit Food" of money. Everything the Money Facts label shows is entered here — or
   pulled from the item's own history via Autofill (typical amount + cadence guess), the
   app's stand-in for Lose It's label-scanning camera. Micros are optional: skip them for
   a coffee, fill them for a loan, and the label grows the matching sections. *@

<div class="pg-head">
    <button class="back-chip" type="button" @onclick="Cancel"><Icon Name="chevron-left" Size="16" /> Cancel</button>
    <h1 class="pg-title small">@(Id is null ? "New item" : "Edit item")</h1>
    <button class="save-link" type="button" @onclick="SaveAsync">Save</button>
</div>

@if (_loading)
{
    <p class="loading"><em>Loading…</em></p>
}
else if (_accounts.Count == 0)
{
    <div class="alert alert-secondary">Add an account first — every item needs a home account.</div>
}
else
{
    <div class="card-lite">
        <div class="field">
            <label for="it-name">Name — required</label>
            <input id="it-name" class="input" type="text" @bind="_m.Name" placeholder="Netflix, Rent, Gas — Shell…" />
        </div>
        <div class="field last">
            <label for="it-cp">Counterparty</label>
            <input id="it-cp" class="input" type="text" @bind="_m.Counterparty" placeholder="Who gets (or sends) the money" />
        </div>
    </div>

    <div class="two-col">
        <div class="field">
            <label>Direction</label>
            <div class="seg">
                <button type="button" class="@(_m.Direction == TransactionDirection.Expense ? "on exp" : "")"
                        @onclick="() => SetDirection(TransactionDirection.Expense)">Money out</button>
                <button type="button" class="@(_m.Direction == TransactionDirection.Income ? "on inc" : "")"
                        @onclick="() => SetDirection(TransactionDirection.Income)">Money in</button>
            </div>
        </div>
        <div class="field">
            <label>Account</label>
            <select class="input" @bind="_m.AccountId">
                @foreach (var a in _accounts)
                {
                    <option value="@a.Id">@a.Name</option>
                }
            </select>
        </div>
    </div>

    <div class="field">
        <label>Repeats</label>
        <div class="seg">
            <button type="button" class="@(_m.Frequency is null ? "on" : "")" @onclick="() => SetFreq(null)">Off</button>
            <button type="button" class="@(_m.Frequency == RepeatFrequency.Weekly ? "on" : "")" @onclick="() => SetFreq(RepeatFrequency.Weekly)">Weekly</button>
            <button type="button" class="@(_m.Frequency == RepeatFrequency.Biweekly ? "on" : "")" @onclick="() => SetFreq(RepeatFrequency.Biweekly)">2 weeks</button>
            <button type="button" class="@(_m.Frequency == RepeatFrequency.Monthly ? "on" : "")" @onclick="() => SetFreq(RepeatFrequency.Monthly)">Monthly</button>
        </div>
    </div>

    @if (_m.Frequency is not null)
    {
        <div class="two-col">
            <div class="field">
                <label for="it-start">Starts / anchor date</label>
                <input id="it-start" class="input" type="date" @bind="_m.StartDate" />
            </div>
            @if (_m.Direction == TransactionDirection.Income)
            {
                <div class="field">
                    <label for="it-save">Auto-save %</label>
                    <input id="it-save" class="input" type="number" min="0" max="100" @bind="_m.SavingsPercent" />
                </div>
            }
        </div>
    }

    @if (_m.Direction == TransactionDirection.Expense)
    {
        <div class="field">
            <label>Counts as — the macro</label>
            <div class="chips">
                @foreach (var (bucket, label, icon) in BucketChips)
                {
                    <button type="button" class="chip @(_m.Bucket == bucket ? "on" : "")"
                            @onclick="() => _m.Bucket = _m.Bucket == bucket ? null : bucket">
                        <Icon Name="@icon" Size="13" /> @label
                    </button>
                }
            </div>
        </div>
    }

    @if (_categories.Count > 0)
    {
        <div class="field">
            <label>Category</label>
            <div class="chips">
                @foreach (var c in _categories)
                {
                    <button type="button" class="chip @(_m.CategoryId == c.Id ? "on" : "")"
                            @onclick="() => _m.CategoryId = _m.CategoryId == c.Id ? null : c.Id">@c.Name</button>
                }
            </div>
        </div>
    }

    <div class="eyebrow"><span>Serving — what one log means</span></div>
    <div class="card-lite">
        <div class="two-col tight">
            <div class="field">
                <label for="it-unit">Unit name</label>
                <input id="it-unit" class="input" type="text" @bind="_m.UnitName" placeholder="month, tank, visit…" />
            </div>
            <div class="field">
                <label for="it-amt">$ per serving — required</label>
                <input id="it-amt" class="input" type="number" step="0.01" min="0" @bind="_m.Amount" />
            </div>
        </div>
        @if (_stats is { TimesLogged: >= 2 })
        {
            <button class="autofill" type="button" @onclick="Autofill">
                <Icon Name="sparkles" Size="15" /> Autofill from history
                <small>@AutofillHint()</small>
            </button>
        }
    </div>

    <div class="eyebrow"><span>Money micros — powers the facts label</span></div>
    <div class="card-lite">
        <div class="two-col tight">
            <div class="field">
                <label for="it-apr">APR %</label>
                <input id="it-apr" class="input" type="number" step="0.01" min="0" @bind="_m.AprPct" placeholder="—" />
            </div>
            <div class="field">
                <label>Interest model</label>
                <select class="input" @bind="_m.Interest">
                    <option value="@InterestModel.None">None</option>
                    <option value="@InterestModel.Simple">Simple</option>
                    <option value="@InterestModel.CompoundDaily">Compounds daily</option>
                    <option value="@InterestModel.CompoundMonthly">Compounds monthly</option>
                    <option value="@InterestModel.CompoundAnnually">Compounds yearly</option>
                </select>
            </div>
        </div>
        <div class="two-col tight">
            <div class="field">
                <label for="it-prin">Balance remaining $</label>
                <input id="it-prin" class="input" type="number" step="0.01" min="0" @bind="_m.PrincipalBalance" placeholder="—" />
            </div>
            <div class="field">
                <label>Plan — made / total</label>
                <div class="plan-pair">
                    <input class="input" type="number" min="0" @bind="_m.PlanPaymentsMade" placeholder="—" aria-label="Payments made" />
                    <span>of</span>
                    <input class="input" type="number" min="0" @bind="_m.PlanPaymentsTotal" placeholder="—" aria-label="Payments total" />
                </div>
            </div>
        </div>
        <div class="two-col tight">
            <div class="field">
                <label for="it-roi">Expected return %/yr</label>
                <input id="it-roi" class="input" type="number" step="0.01" min="0" @bind="_m.ExpectedReturnPct" placeholder="—" />
            </div>
            <div class="field">
                <label for="it-fees">Fees per serving $</label>
                <input id="it-fees" class="input" type="number" step="0.01" min="0" @bind="_m.FeesPerUnit" placeholder="—" />
            </div>
        </div>
        <div class="field last">
            <label>Tax deductible</label>
            <div class="seg">
                <button type="button" class="@(!_m.IsTaxDeductible ? "on" : "")" @onclick="() => _m.IsTaxDeductible = false">No</button>
                <button type="button" class="@(_m.IsTaxDeductible ? "on" : "")" @onclick="() => _m.IsTaxDeductible = true">Yes</button>
            </div>
        </div>
    </div>

    @if (_error is not null)
    {
        <p class="form-error">@_error</p>
    }

    <div class="save-bar">
        <button class="go" type="button" @onclick="SaveAsync">Save item</button>
    </div>
}

@code {
    [Parameter] public Guid? Id { get; set; }

    private bool _loading = true;
    private string? _error;
    private IReadOnlyList<AccountDto> _accounts = Array.Empty<AccountDto>();
    private IReadOnlyList<CategoryDto> _categories = Array.Empty<CategoryDto>();
    private ItemStatsDto? _stats;
    private ItemDto? _existing;
    private readonly Model _m = new();

    private static readonly (MacroBucket Bucket, string Label, string Icon)[] BucketChips =
    {
        (MacroBucket.Needs, "Need", "home"),
        (MacroBucket.Wants, "Want", "sparkles"),
        (MacroBucket.Debt, "Debt", "credit-card"),
        (MacroBucket.Future, "Future", "trending-up"),
    };

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _accounts = await AccountSvc.ListAsync();

        if (Id is Guid id && await ItemSvc.GetAsync(id) is { } s)
        {
            _existing = s;
            _m.Name = s.Name;
            _m.Counterparty = s.Counterparty;
            _m.Amount = s.Amount;
            _m.UnitName = s.UnitName;
            _m.Direction = s.Direction;
            _m.Bucket = s.Bucket;
            _m.Frequency = s.Frequency;
            _m.StartDate = (s.StartDate ?? DateOnly.FromDateTime(DateTime.Today)).ToDateTime(TimeOnly.MinValue);
            _m.AccountId = s.AccountId;
            _m.CategoryId = s.CategoryId;
            _m.SavingsPercent = s.SavingsPercent;
            _m.AprPct = s.AprPct;
            _m.Interest = s.Interest;
            _m.PrincipalBalance = s.PrincipalBalance;
            _m.PlanPaymentsMade = s.PlanPaymentsMade;
            _m.PlanPaymentsTotal = s.PlanPaymentsTotal;
            _m.ExpectedReturnPct = s.ExpectedReturnPct;
            _m.FeesPerUnit = s.FeesPerUnit;
            _m.IsTaxDeductible = s.IsTaxDeductible;
            _stats = await ItemSvc.GetStatsAsync(id);
        }
        else if (_accounts.Count > 0 && _m.AccountId == Guid.Empty)
        {
            _m.AccountId = _accounts[0].Id;
        }

        await LoadCategoriesAsync();
        _loading = false;
    }

    private async Task SetDirection(TransactionDirection dir)
    {
        if (_m.Direction == dir) return;
        _m.Direction = dir;
        if (dir == TransactionDirection.Income) _m.Bucket = null;   // macros are an outflow idea
        await LoadCategoriesAsync();
    }

    private void SetFreq(RepeatFrequency? f) => _m.Frequency = f;

    private async Task LoadCategoriesAsync()
    {
        var kind = _m.Direction == TransactionDirection.Income ? CategoryKind.Income : CategoryKind.Expense;
        _categories = await CategorySvc.ListAsync(kind);
        if (_m.CategoryId is Guid cid && _categories.All(c => c.Id != cid))
            _m.CategoryId = null;
    }

    // Fill the serving from the item's own logs: median per-serving amount, plus a cadence
    // guess when the item doesn't repeat yet. The camera-autofill of bank data.
    private void Autofill()
    {
        if (_stats is not { } st) return;
        if (st.TypicalAmount is decimal typical && typical > 0m) _m.Amount = typical;
        if (_m.Frequency is null && st.GuessedFrequency is RepeatFrequency f)
        {
            _m.Frequency = f;
            if (st.LastLogged is DateOnly last) _m.StartDate = last.ToDateTime(TimeOnly.MinValue);
        }
    }

    private string AutofillHint()
    {
        if (_stats is not { } st) return "";
        var parts = new List<string>();
        if (st.TypicalAmount is decimal t) parts.Add($"≈{t:C} typical");
        if (_m.Frequency is null && st.GuessedFrequency is RepeatFrequency f) parts.Add($"looks {f.ToString().ToLowerInvariant()}");
        return string.Join(" · ", parts);
    }

    private async Task SaveAsync()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_m.Name)) { _error = "Give the item a name."; return; }
        if (_m.Amount <= 0m) { _error = "Enter a per-serving amount greater than 0."; return; }
        if (_m.AccountId == Guid.Empty) { _error = "Pick an account."; return; }

        var dto = new ItemUpsertDto(
            Id,
            _m.Name.Trim(),
            _m.Amount,
            _m.Direction,
            _m.Frequency,
            _m.Frequency is null ? null : DateOnly.FromDateTime(_m.StartDate),
            _m.AccountId,
            _m.CategoryId,
            _existing?.Icon,
            _m.Direction == TransactionDirection.Income ? Math.Clamp(_m.SavingsPercent, 0, 100) : 0,
            NullIfBlank(_m.Counterparty),
            NullIfBlank(_m.UnitName),
            _m.Direction == TransactionDirection.Income ? null : _m.Bucket,
            _m.AprPct,
            _m.Interest,
            _m.PrincipalBalance,
            _m.PlanPaymentsTotal,
            _m.PlanPaymentsMade,
            _m.ExpectedReturnPct,
            _m.FeesPerUnit,
            _m.IsTaxDeductible);

        try
        {
            var saved = await ItemSvc.UpsertAsync(dto);
            Nav.NavigateTo($"/library/item/{saved.Id}");
        }
        catch (ArgumentException ex)
        {
            _error = ex.Message;
        }
    }

    private void Cancel() =>
        Nav.NavigateTo(Id is Guid id ? $"/library/item/{id}" : "/library");

    private static string? NullIfBlank(string? s) => string.IsNullOrWhiteSpace(s) ? null : s.Trim();

    private class Model
    {
        public string Name { get; set; } = string.Empty;
        public string? Counterparty { get; set; }
        public decimal Amount { get; set; }
        public string? UnitName { get; set; }
        public TransactionDirection Direction { get; set; } = TransactionDirection.Expense;
        public MacroBucket? Bucket { get; set; }
        public RepeatFrequency? Frequency { get; set; }
        public DateTime StartDate { get; set; } = DateTime.Today;
        public Guid AccountId { get; set; }
        public Guid? CategoryId { get; set; }
        public int SavingsPercent { get; set; }
        public decimal? AprPct { get; set; }
        public InterestModel Interest { get; set; }
        public decimal? PrincipalBalance { get; set; }
        public int? PlanPaymentsMade { get; set; }
        public int? PlanPaymentsTotal { get; set; }
        public decimal? ExpectedReturnPct { get; set; }
        public decimal? FeesPerUnit { get; set; }
        public bool IsTaxDeductible { get; set; }
    }
}
