@* Monoline SVG icon set. Names follow Lucide/Feather (the same vocabulary
   Category.Icon already stores in the DB, e.g. "briefcase", "shopping-cart"),
   plus account-type and navigation glyphs. Colour comes from currentColor, so
   wrap in a tinted .tile (or set color on a parent) to recolour.

   Usage: <Icon Name="shopping-cart" />  ·  <Icon Name="home" Class="n2f-ico" /> *@
<svg class="n2f-ico @Class" viewBox="0 0 24 24" fill="none" stroke="currentColor"
     stroke-width="@StrokeWidth" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
     style="@SizeStyle">
    @((MarkupString)Paths(Name))
</svg>

@code {
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public string? Class { get; set; }
    [Parameter] public string StrokeWidth { get; set; } = "2";
    /// <summary>Optional explicit px size. Set it for inline icons inside a
    /// consuming component — page-scoped CSS can't size this child element, so
    /// an inline size is the reliable lever (tiles size via global .tile .n2f-ico).</summary>
    [Parameter] public int? Size { get; set; }

    private string? SizeStyle => Size is int s ? $"width:{s}px;height:{s}px" : null;

