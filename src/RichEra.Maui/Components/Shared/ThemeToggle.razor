@inject IJSRuntime JS

@* Shared light/dark theme toggle — Aurora (light) ⇄ Midnight (dark).
   Round icon-only button (.app-icon-btn). Reads/sets the theme via
   window.n2fTheme (localStorage + data-theme on <html>, applied before CSS
   parses on boot, see index.html). Drop <ThemeToggle /> into any page header.
   Pass CssClass for layout helpers (e.g. "ms-2"). *@
<button class="app-icon-btn @CssClass" type="button"
        @onclick="ToggleAsync"
        title="@(isDark ? "Switch to Aurora (light)" : "Switch to Midnight (dark)")"
        aria-label="Toggle light or dark theme">
    @if (isDark)
    {
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
    }
    else
    {
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
    }
</button>

@code {
    /// <summary>Optional extra classes for layout (e.g. "ms-2").</summary>
    [Parameter] public string? CssClass { get; set; }

    private bool isDark;
    private bool _read;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_read)
        {
            _read = true;
            try
            {
                var t = await JS.InvokeAsync<string>("n2fTheme.get");
                if (string.Equals(t, "dark", StringComparison.OrdinalIgnoreCase))
                {
                    isDark = true;
                    StateHasChanged();
                }
            }
            catch { /* JS not ready — defaults to the light (moon) glyph */ }
        }
    }

    private async Task ToggleAsync()
    {
        try
        {
            var t = await JS.InvokeAsync<string>("n2fTheme.toggle");
            isDark = string.Equals(t, "dark", StringComparison.OrdinalIgnoreCase);
        }
        catch { /* best-effort */ }
    }
}
