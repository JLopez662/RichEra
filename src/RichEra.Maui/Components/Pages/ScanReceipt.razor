@page "/scan"
@using RichEra.Application.Abstractions
@using RichEra.Application.Dtos
@using RichEra.Domain.Entities
@inject IReceiptScanService ScanSvc
@inject IAccountService AccountSvc
@inject ICategoryService CategorySvc
@inject ITransactionService TxnSvc
@inject NavigationManager Nav

<PageTitle>Scan receipt</PageTitle>

@* On-device receipt scanning: pick a photo, OCR + parse it locally into candidate lines, then
   review/edit before each becomes an expense Transaction. The parse is a best guess, so the
   review step is deliberate — a misread never silently lands in the ledger. *@

<div class="pg-head">
    <button class="back-chip" type="button" @onclick="Back"><Icon Name="chevron-left" Size="16" /> Back</button>
    <h1 class="pg-title small">Scan receipt</h1>
    <span class="hd-gap" aria-hidden="true"></span>
</div>

@if (_loading)
{
    <p class="loading"><em>Loading…</em></p>
}
else if (_accounts.Count == 0)
{
    <div class="alert alert-secondary">Add an account first — logged items need a home account.</div>
}
else if (_stage == Stage.Start)
{
    <div class="scan-intro">
        <div class="scan-hero"><Icon Name="receipt" Size="30" /></div>
        <div class="si-t">Turn a receipt into logged items</div>
        <div class="si-s">Pick a photo of a printed receipt. It's read right on your device — no
            internet, no account, nothing leaves this device. You'll review every line before
            anything is logged.</div>
        <button class="go" type="button" @onclick="PickAndScanAsync">
            <Icon Name="image" Size="16" /> Choose receipt photo
        </button>
        @if (_err is not null)
        {
            <p class="form-error">@_err</p>
        }
    </div>
}
else if (_stage == Stage.Reading)
{
    <div class="scan-intro">
        <div class="scan-hero"><span class="spinner"></span></div>
        <div class="si-t">Reading the receipt…</div>
        <div class="si-s">Recognizing text on your device. A long receipt can take a few seconds.</div>
    </div>
}
else if (_stage == Stage.Done)
{
    <div class="scan-intro">
        <div class="scan-hero ok"><Icon Name="check-circle" Size="30" /></div>
        <div class="si-t">Logged @_loggedCount item@(_loggedCount == 1 ? "" : "s")</div>
        <div class="si-s">They're in your transactions now, against @AccountName.</div>
        <button class="go" type="button" @onclick='() => Nav.NavigateTo("/library")'>Back to Library</button>
        <button class="linkbtn" type="button" @onclick="Reset">Scan another receipt</button>
    </div>
}
else
{
    <div class="eyebrow">
        <span>@_lines.Count line@(_lines.Count == 1 ? "" : "s") found</span>
        @if (_rawText.Length > 0)
        {
            <span class="eyebrow__link" @onclick="() => _showRaw = !_showRaw">@(_showRaw ? "Hide" : "Show") raw text ›</span>
        }
    </div>

    @if (_showRaw)
    {
        <pre class="rc-raw">@_rawText</pre>
    }

    @if (_lines.Count == 0)
    {
        <div class="rc-empty">
            <div class="si-t">Couldn't pull any lines from that photo.</div>
            <div class="si-s">Receipts with faint or angled text are hard to read. Try a straighter,
                brighter photo — or add lines by hand below.</div>
        </div>
    }
    else
    {
        <div class="rc-list">
            @foreach (var line in _lines)
            {
                <div class="rc-row">
                    <input class="input rc-name" type="text" @bind="line.Name" placeholder="Item name" />
                    <div class="rc-amt">
                        <span>$</span>
                        <input class="input" type="number" step="0.01" min="0" @bind="line.Amount" />
                    </div>
                    <button class="rc-del" type="button" @onclick="() => Remove(line)" aria-label="Remove line">
                        <Icon Name="x" Size="15" />
                    </button>
                </div>
            }
        </div>
    }

    <button class="rc-add" type="button" @onclick="AddLine"><Icon Name="plus" Size="15" /> Add a line</button>

    <div class="eyebrow"><span>Log all lines as</span></div>
    <div class="card-lite">
        <div class="two-col">
            <div class="field">
                <label>Pay from</label>
                <select class="input" @bind="_accountId">
                    @foreach (var a in _accounts)
                    {
                        <option value="@a.Id">@a.Name</option>
                    }
                </select>
            </div>
            <div class="field">
                <label for="rc-date">Date</label>
                <input id="rc-date" class="input" type="date" @bind="_date" />
            </div>
        </div>
        @if (_categories.Count > 0)
        {
            <div class="field last">
                <label>Category — optional</label>
                <div class="rc-chips">
                    <button type="button" class="rc-chip @(_categoryId is null ? "on" : "")" @onclick="() => _categoryId = null">None</button>
                    @foreach (var c in _categories)
                    {
                        <button type="button" class="rc-chip @(_categoryId == c.Id ? "on" : "")" @onclick="() => _categoryId = c.Id">@c.Name</button>
                    }
                </div>
            </div>
        }
    </div>

    <div class="rc-summary">
        <span>@_loggable.Count item@(_loggable.Count == 1 ? "" : "s") ready</span>
        <strong>@_loggableTotal.ToString("C")</strong>
    </div>

    @if (_err is not null)
    {
        <p class="form-error">@_err</p>
    }

    <div class="save-bar">
        <button class="go" type="button" @onclick="LogAllAsync" disabled="@(_busy || _loggable.Count == 0)">
            @(_busy ? "Logging…" : $"Log {_loggable.Count} item{(_loggable.Count == 1 ? "" : "s")}")
        </button>
        <button class="linkbtn" type="button" @onclick="Reset">Choose a different photo</button>
    </div>
}

@code {
    private enum Stage { Start, Reading, Review, Done }

    private bool _loading = true;
    private Stage _stage = Stage.Start;
    private string? _err;
    private bool _busy;
    private bool _showRaw;
    private string _rawText = string.Empty;
    private int _loggedCount;

    private readonly List<Row> _lines = new();
    private IReadOnlyList<AccountDto> _accounts = Array.Empty<AccountDto>();
    private IReadOnlyList<CategoryDto> _categories = Array.Empty<CategoryDto>();
    private Guid _accountId;
    private Guid? _categoryId;
    private DateTime _date = DateTime.Today;

    // A line is "ready" once it has a name and a positive amount — the only ones that get logged.
    private List<Row> _loggable => _lines.Where(l => !string.IsNullOrWhiteSpace(l.Name) && l.Amount > 0m).ToList();
    private decimal _loggableTotal => _loggable.Sum(l => l.Amount);
    private string AccountName => _accounts.FirstOrDefault(a => a.Id == _accountId)?.Name ?? "your account";

    protected override async Task OnInitializedAsync()
    {
        _accounts = await AccountSvc.ListAsync();
        if (_accounts.Count > 0)
        {
            // Default to the account most people pay a store from: Checking, then Cash, then first.
            var def = _accounts.FirstOrDefault(a => a.Type == AccountType.Checking)
                      ?? _accounts.FirstOrDefault(a => a.Type == AccountType.Cash)
                      ?? _accounts[0];
            _accountId = def.Id;
        }
        _categories = await CategorySvc.ListAsync(CategoryKind.Expense);
        _loading = false;
    }

    private async Task PickAndScanAsync()
    {
        _err = null;
        try
        {
            var file = await Microsoft.Maui.Media.MediaPicker.Default.PickPhotoAsync();
            if (file is null) return; // user cancelled

            _stage = Stage.Reading;
            StateHasChanged();

            byte[] bytes;
            await using (var src = await file.OpenReadAsync())
            {
                using var ms = new MemoryStream();
                await src.CopyToAsync(ms);
                bytes = ms.ToArray();
            }

            var result = await ScanSvc.ScanAsync(bytes);
            _rawText = result.RawText;
            _lines.Clear();
            _lines.AddRange(result.Lines.Select(l => new Row { Name = l.Name, Amount = l.Amount, RawText = l.RawText }));
            _stage = Stage.Review;
        }
        catch (Exception ex)
        {
            _err = $"Couldn't read that photo: {ex.Message}";
            _stage = Stage.Start;
        }
    }

    private void AddLine() => _lines.Add(new Row());
    private void Remove(Row row) => _lines.Remove(row);

    private async Task LogAllAsync()
    {
        _err = null;
        var toLog = _loggable;
        if (toLog.Count == 0)
        {
            _err = "Add at least one line with a name and an amount greater than 0.";
            return;
        }
        if (_accountId == Guid.Empty)
        {
            _err = "Pick an account to log against.";
            return;
        }

        _busy = true;
        try
        {
            var date = DateOnly.FromDateTime(_date);
            foreach (var l in toLog)
            {
                await TxnSvc.UpsertAsync(new TransactionUpsertDto(
                    null, date, _accountId, _categoryId,
                    l.Amount, TransactionDirection.Expense, l.Name.Trim()));
            }
            _loggedCount = toLog.Count;
            _stage = Stage.Done;
        }
        catch (Exception ex)
        {
            _err = $"Couldn't log the items: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    private void Reset()
    {
        _lines.Clear();
        _rawText = string.Empty;
        _showRaw = false;
        _err = null;
        _stage = Stage.Start;
    }

    private void Back() => Nav.NavigateTo("/library");

    private sealed class Row
    {
        public string Name { get; set; } = string.Empty;
        public decimal Amount { get; set; }
        public string RawText { get; set; } = string.Empty;
    }
}
