@* One post = one Short from a followed channel or a saved search.

   Nothing loads until the post is tapped: until then the card is a poster frame, so a feed full
   of shorts costs one image each rather than one player each. The feed marks only one post
   Playing at a time, so tapping a second short tears the first player out of the DOM — which is
   also what stops its audio. *@
@using RichEra.Application.Dtos
@using Microsoft.Maui.ApplicationModel
@implements IDisposable
@inject IJSRuntime JS

<article class="fp">
    <div class="fp__top">
        <div class="fp__av" style="background:@Gradient">@Initial</div>
        <div class="fp__id">
            <div class="fp__name">@Name</div>
            @if (HasHandle)
            {
                <div class="fp__sub">@Card.ChannelTitle</div>
            }
        </div>
        <button class="fp__more" type="button" aria-label="Open in YouTube" @onclick="OpenExternallyAsync">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true"><circle cx="5" cy="12" r="1"/><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/></svg>
        </button>
    </div>

    <div class="fp__reel @(Playing && !blocked ? "is-live" : null)">
        @if (Playing && !blocked)
        {
            <iframe @ref="frame" class="fp__player" src="@Card.EmbedUrl" title="@Card.Title"
                    allow="autoplay; encrypted-media; picture-in-picture"
                    referrerpolicy="strict-origin-when-cross-origin"></iframe>
        }
        else
        {
            <button class="fp__poster" type="button" @onclick="PlayAsync" aria-label="@($"Play {Card.Title}")">
                @* oar2 is the vertical frame as shot; hqdefault is the 4:3 one every video has.
                   Both are cropped to the card, so the fallback costs framing, not layout. *@
                <img src="@Card.PosterUrl" alt="" loading="lazy"
                     onerror="this.onerror=null;this.src='@Card.PosterFallbackUrl'" />
                <span class="fp__veil"></span>
                @if (blocked)
                {
                    @* Roughly one short in five won't play in an embed, and YouTube gives no
                       warning until the player is already on screen. Say so, and point at the one
                       place it will play. *@
                    <span class="fp__warn">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                    </span>
                    <span class="fp__blocked">
                        <b>Not playable in-app</b>
                        <span>YouTube only allows this one on youtube.com — tap below to open it there.</span>
                    </span>
                }
                else
                {
                    <span class="fp__play">
                        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
                    </span>
                }
                <span class="fp__badge">SHORT</span>
            </button>
        }
    </div>

    <div class="fp__acts">
        <div class="fp__acts-l">
            <button class="fp__act @(Card.Saved ? "is-on" : null)" type="button"
                    aria-label="@(Card.Saved ? "Saved" : "Save")" aria-pressed="@(Card.Saved ? "true" : "false")"
                    @onclick="ToggleSaveAsync">
                <svg viewBox="0 0 24 24" fill="@(Card.Saved ? "currentColor" : "none")" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
            </button>
            <button class="fp__act" type="button" aria-label="Not for me — hide this short" @onclick="HideAsync">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 14V2"/><path d="M9 18.12 10 14H4.17a2 2 0 0 1-1.92-2.56l2.33-8A2 2 0 0 1 6.5 2H20a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-2.76a2 2 0 0 0-1.79 1.11L12 22a3.13 3.13 0 0 1-3-3.88z"/></svg>
            </button>
        </div>
        <button class="fp__act is-yt" type="button" aria-label="Open in YouTube" @onclick="OpenExternallyAsync">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23 12s0-3.9-.5-5.8a3 3 0 0 0-2.1-2.1C18.5 3.6 12 3.6 12 3.6s-6.5 0-8.4.5A3 3 0 0 0 1.5 6.2C1 8.1 1 12 1 12s0 3.9.5 5.8a3 3 0 0 0 2.1 2.1c1.9.5 8.4.5 8.4.5s6.5 0 8.4-.5a3 3 0 0 0 2.1-2.1C23 15.9 23 12 23 12zM9.8 15.6V8.4l6.3 3.6z"/></svg>
        </button>
    </div>

    @* Why this is in your feed: a channel you follow, or a search you saved. *@
    <div class="fp__why">
        @if (Card.FoundVia is { } search)
        {
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><line x1="20" y1="20" x2="16.6" y2="16.6"/></svg>
            <span>&ldquo;@search&rdquo; · <span class="fp__why-tag">@Card.ChannelTitle</span></span>
        }
        else
        {
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Following · <span class="fp__why-tag">@Card.ChannelTitle</span></span>
        }
    </div>

    <div class="fp__cap"><b>@Name</b> @Card.Title</div>

    <div class="fp__foot">
        <span class="fp__time">@TimeLabel</span>
        <button class="fp__ext" type="button" @onclick="OpenExternallyAsync">
            Open in YouTube
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        </button>
    </div>
</article>

@code {
    [Parameter, EditorRequired] public ShortCard Card { get; set; } = default!;

    /// <summary>Set by the feed on the one post that owns playback.</summary>
    [Parameter] public bool Playing { get; set; }

    /// <summary>Raised with this post's video id when its poster is tapped.</summary>
    [Parameter] public EventCallback<string> OnPlay { get; set; }

    /// <summary>Raised when the bookmark is toggled. The feed owns the state so the Saved filter
    /// and the card can't disagree.</summary>
    [Parameter] public EventCallback<string> OnToggleSave { get; set; }

    /// <summary>Raised when the viewer hides this short. The feed drops the post.</summary>
    [Parameter] public EventCallback<string> OnHide { get; set; }

    /// <summary>This video loaded a player but never played — see richEraShorts in feed-shorts.js.</summary>
    private bool blocked;

    private ElementReference frame;
    private DotNetObjectReference<ShortPost>? self;
    private bool watching;
    private string? loadedVideoId;

    /// <summary>A search hit doesn't always come with a handle; then the name is all there is.</summary>
    private bool HasHandle => !string.IsNullOrWhiteSpace(Card.ChannelHandle);

    private string Name => HasHandle ? "@" + Card.ChannelHandle : Card.ChannelTitle;

    private string Initial =>
        string.IsNullOrWhiteSpace(Card.ChannelTitle) ? "?" : Card.ChannelTitle.Trim()[..1].ToUpperInvariant();

    /// <summary>Deterministic per channel, so the same creator keeps the same avatar colour across
    /// a reshuffle instead of flickering to a new one each batch.</summary>
    private string Gradient
    {
        get
        {
            var palette = new[] { "#ff3040", "#f59e0b", "#10b981", "#6366f1", "#06b6d4", "#d946ef" };
            var key = HasHandle ? Card.ChannelHandle : Card.ChannelTitle;
            var hash = 0;
            foreach (var ch in key) hash = unchecked(hash * 31 + ch);
            // Masked rather than Math.Abs: int.MinValue has no positive counterpart and would throw.
            var hue = palette[(hash & 0x7FFFFFFF) % palette.Length];
            return $"linear-gradient(150deg, {hue}, #0d0d14)";
        }
    }

    private string TimeLabel => Card.Published is { } p ? $"Short · {Ago(p)}" : "Short";

    /// <summary>
    /// A reshuffle hands this same post a different short, so anything learned about the last one
    /// has to go with it — otherwise the new video inherits the old one's "won't play" verdict.
    /// </summary>
    protected override void OnParametersSet()
    {
        if (loadedVideoId == Card.VideoId) return;
        loadedVideoId = Card.VideoId;
        blocked = false;
    }

    private Task PlayAsync()
    {
        blocked = false;   // a retry deserves a fresh player; the failure can be the network
        return OnPlay.InvokeAsync(Card.VideoId);
    }

    private Task ToggleSaveAsync() => OnToggleSave.InvokeAsync(Card.VideoId);

    private Task HideAsync() => OnHide.InvokeAsync(Card.VideoId);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var shouldWatch = Playing && !blocked;
        if (shouldWatch == watching) return;
        watching = shouldWatch;

        try
        {
            if (shouldWatch)
            {
                self ??= DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("richEraShorts.watch", frame, self);
            }
            else
            {
                await JS.InvokeVoidAsync("richEraShorts.stop");
            }
        }
        catch (JSDisconnectedException) { /* view torn down mid-play */ }
        catch (JSException) { /* feed-shorts.js not loaded — the card still works, just without the fallback */ }
    }

    /// <summary>Called from JS when the player errored, or never got as far as playing.</summary>
    [JSInvokable]
    public Task OnEmbedFailed()
    {
        blocked = true;
        return InvokeAsync(StateHasChanged);
    }

    public void Dispose() => self?.Dispose();

    private async Task OpenExternallyAsync()
    {
        try { await Launcher.Default.OpenAsync(Card.WatchUrl); }
        catch (Exception) { /* no browser / no YouTube app on this device */ }
    }

    private static string Ago(DateTimeOffset when)
    {
        var span = DateTimeOffset.UtcNow - when;
        if (span < TimeSpan.Zero) return "just now";
        if (span < TimeSpan.FromHours(1)) return $"{Math.Max(1, (int)span.TotalMinutes)}m ago";
        if (span < TimeSpan.FromDays(1)) return $"{(int)span.TotalHours}h ago";
        if (span < TimeSpan.FromDays(7)) return $"{(int)span.TotalDays}d ago";
        if (span < TimeSpan.FromDays(30)) return $"{(int)(span.TotalDays / 7)}w ago";
        if (span < TimeSpan.FromDays(365)) return $"{(int)(span.TotalDays / 30)}mo ago";
        return $"{(int)(span.TotalDays / 365)}y ago";
    }
}
